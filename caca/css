@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Poppins:wght@300;400;500;600&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:flex-start;
    padding:60px 20px;

    font-family:'Poppins',sans-serif;

    background:
    radial-gradient(circle at top,#3b1b7a 0%,transparent 35%),
    radial-gradient(circle at bottom,#0099ff33 0%,transparent 30%),
    linear-gradient(135deg,#05060f,#0a1027,#13193f,#090b18);

    overflow-x:hidden;
    position:relative;
}

/* Garis Grid */

body::before{

    content:"";

    position:fixed;

    inset:0;

    background-image:

    linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),

    linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);

    background-size:45px 45px;

    z-index:0;

}

/* Glow */

body::after{

    content:"";

    position:fixed;

    width:450px;

    height:450px;

    background:#6d28ff55;

    border-radius:50%;

    filter:blur(130px);

    top:-120px;

    right:-80px;

    animation:glow 8s ease-in-out infinite alternate;

}

@keyframes glow{

from{

transform:translateY(0);

}

to{

transform:translateY(80px);

}

}

/* Bintang */

.stars{

    position:fixed;

    inset:0;

    background-image:

    radial-gradient(circle,#ffffff 1px,transparent 2px);

    background-size:120px 120px;

    opacity:.35;

    animation:starsMove 70s linear infinite;

    z-index:0;

}

@keyframes starsMove{

from{

transform:translateY(0);

}

to{

transform:translateY(-1200px);

}

}

/* Card */

.form-card{

    position:relative;

    z-index:5;

    width:100%;

    max-width:720px;

    padding:35px;

    border-radius:20px;

    background:rgba(16,18,35,.72);

    backdrop-filter:blur(20px);

    border:1px solid rgba(0,255,255,.25);

    box-shadow:

    0 0 20px #00c8ff55,

    0 0 50px #7b2cff33,

    inset 0 0 25px rgba(255,255,255,.04);

}

/* Judul */

.form-card::before{

content:"🎮 EKTRAKULIKULER";

display:block;

font-family:'Orbitron',sans-serif;

font-size:30px;

font-weight:bold;

text-align:center;

color:#00e5ff;

letter-spacing:2px;

margin-bottom:8px;

text-shadow:0 0 12px #00e5ff;

}

.form-card::after{

content:"Fill in your profile to join the guild.";

display:block;

text-align:center;

color:#b8d8ff;

margin-bottom:30px;

}

/* Form */

#user-data{

display:flex;

flex-direction:column;

}

/* Label */

label{

color:#ffffff;

font-weight:600;

margin-top:15px;

margin-bottom:8px;

}

p{

color:#66f2ff;

font-weight:bold;

margin-top:20px;

margin-bottom:10px;

}

/* Input */

input[type=text],
select{

width:100%;

padding:14px 16px;

background:#141b33;

border:1px solid #2b5cff;

border-radius:12px;

color:white;

font-size:15px;

outline:none;

transition:.35s;

}

input::placeholder{

color:#93bfff;

}

select option{

background:#141b33;

color:white;

}

input:focus,
select:focus{

border-color:#00e5ff;

box-shadow:

0 0 15px #00e5ff66;

}

/* Radio & Checkbox */

input[type=radio],
input[type=checkbox]{

accent-color:#00e5ff;

margin-right:8px;

}

label:has(input[type=radio]),
label:has(input[type=checkbox]){

display:flex;

align-items:center;

background:#151d3a;

padding:10px 14px;

border:1px solid transparent;

border-radius:10px;

transition:.3s;

cursor:pointer;

}

label:has(input[type=radio]):hover,
label:has(input[type=checkbox]):hover{

border-color:#00e5ff;

background:#1c2952;

box-shadow:0 0 12px #00e5ff44;

}

/* Tombol */

button{

margin-top:35px;

padding:16px;

font-family:'Orbitron',sans-serif;

font-size:16px;

font-weight:bold;

letter-spacing:1px;

border:none;

border-radius:12px;

cursor:pointer;

color:white;

background:linear-gradient(90deg,#00c8ff,#7b2cff);

transition:.35s;

}

button:hover{

transform:translateY(-4px);

box-shadow:

0 0 20px #00c8ff,

0 0 40px #7b2cff;

}

button:active{

transform:scale(.98);

}

/* Scroll */

::-webkit-scrollbar{

width:10px;

}

::-webkit-scrollbar-track{

background:#0d1122;

}

::-webkit-scrollbar-thumb{

background:#00c8ff;

border-radius:20px;

}

/* Responsive */

@media(max-width:700px){

.form-card{

padding:25px;

}

.form-card::before{

font-size:22px;

}

}